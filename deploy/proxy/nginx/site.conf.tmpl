# ---------- HTTP :80 — ACME HTTP-01 and the redirect ----------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{DOMAIN}}{{EXTRA_DOMAINS_SUFFIX}};

    location = /healthz { access_log off; return 200 "ok\n"; add_header Content-Type text/plain; }

    # `certbot` mode uses the webroot. In `acme` mode the module answers
    # HTTP-01 on this listener before any location is consulted.
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; default_type text/plain; }

    location / { return 301 https://$host$request_uri; }
}

{{EXTRA_DOMAINS_SERVER}}
# ---------- the shop ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    listen 443 quic reuseport;
    listen [::]:443 quic reuseport;
    http2 on;
    server_name {{DOMAIN}};

    include /etc/nginx/conf.d/tls-cert.inc;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d; ssl_session_cache shared:rr_ssl:10m; ssl_session_tickets off;
    add_header Alt-Svc 'h3=":443"; ma=86400' always;

    include /etc/nginx/conf.d/security-headers.inc;
    limit_conn rr_conn 50;

    include /etc/nginx/conf.d/common-proxy.inc;

    # --- provider and panel webhooks: POST only, their own limit, 256k body ---
    location ^~ /webhooks/ {
        limit_req zone=rr_webhooks burst=60 nodelay;
        # Section 21.5: both profiles answer a non-POST webhook with 405.
        # `limit_except` would answer 403, which Caddy never does.
        if ($request_method != POST) { return 405; }
        client_max_body_size 256k;
        proxy_read_timeout 15s;
        proxy_pass http://rr_api;
    }
    # --- the Telegram webhook: POST only ---
    location ^~ /tg/webhook/ {
        limit_req zone=rr_webhooks burst=100 nodelay;
        if ($request_method != POST) { return 405; }
        client_max_body_size 2m;
        proxy_read_timeout 10s;
        proxy_pass http://rr_api;
    }
    # --- authentication: the hard limit ---
    location ^~ /api/v1/auth/ {
        limit_req zone=rr_signin burst=10 nodelay;
        limit_req zone=rr_api burst=30 nodelay;
        proxy_pass http://rr_api;
    }
    location ^~ /api/admin/v1/auth/ {
        limit_req zone=rr_signin burst=10 nodelay;
        limit_req zone=rr_admin burst=120 nodelay;
{{ADMIN_ALLOWLIST_BLOCK}}
        proxy_pass http://rr_api;
    }
    # --- the administration API ---
    location ^~ /api/admin/ {
        limit_req zone=rr_admin burst=120 nodelay;
{{ADMIN_ALLOWLIST_BLOCK}}
        client_max_body_size 10m;
        proxy_pass http://rr_api;
    }
    # --- the setup wizard API ---
    location ^~ /api/setup/ {
        limit_req zone=rr_auth burst=20 nodelay;
        client_max_body_size 5m;
        proxy_pass http://rr_api;
    }
    # --- the bot's and the worker's API (section 9.5): never from outside ---
    location ^~ /api/internal/ {
{{INTERNAL_API_BLOCK}}
    }
    # --- metrics: the compose network only ---
    location = /metrics { allow {{DOCKER_CIDR}}; deny all; proxy_pass http://rr_api; }
    location = /api/docs {
{{API_DOCS_BLOCK}}
        proxy_pass http://rr_api;
    }
    # --- the public API ---
    location ^~ /api/ {
        limit_req zone=rr_api burst=30 nodelay;
        client_max_body_size 1m;
        proxy_pass http://rr_api;
    }
    # --- Next.js static assets: cached on the proxy ---
    location ^~ /_next/static/ {
        proxy_cache rr_static; proxy_cache_valid 200 7d; proxy_cache_use_stale error timeout updating;
        proxy_ignore_headers Set-Cookie; proxy_hide_header Set-Cookie;
        add_header X-Cache-Status $upstream_cache_status;
        expires 365d; add_header Cache-Control "public, immutable" always;
        proxy_pass http://rr_web;
    }
    location ^~ /themes/ {
        proxy_cache rr_static; proxy_cache_valid 200 1d;
        # `web` sends `nosniff` with every theme asset; the proxy adds its own
        # (security-headers.inc), and the header must reach the client once.
        proxy_hide_header X-Content-Type-Options;
        proxy_pass http://rr_web;
    }
    # --- the administration console and the wizard (UI) ---
    location ^~ /admin {
        # `nodelay` like every other zone: without it nginx queues the burst
        # and releases it at 30r/m, so the console stalls for seconds a page
        # while the Caddy profile refuses outright (section 21.5).
        limit_req zone=rr_admin burst=120 nodelay;
{{ADMIN_ALLOWLIST_BLOCK}}
        proxy_pass http://rr_web;
    }
    location ^~ /setup { limit_req zone=rr_auth burst=30 nodelay; proxy_pass http://rr_web; }
    # --- everything else: the site ---
    location / {
        limit_req zone=rr_general burst=50 nodelay;
        proxy_pass http://rr_web;
    }

    location = /healthz { access_log off; return 200 "ok\n"; add_header Content-Type text/plain; }

    include /etc/nginx/conf.d/custom.d/*.conf;
}
