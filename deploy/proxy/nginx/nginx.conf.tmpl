{{LOAD_MODULE_BLOCK}}
user  nginx;
worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 4096; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    server_tokens off;
    sendfile on; tcp_nopush on; tcp_nodelay on;
    keepalive_timeout 65s;
    client_max_body_size 1m;
    client_body_timeout 15s; client_header_timeout 15s; send_timeout 30s;
    types_hash_max_size 2048;
    map_hash_bucket_size 128;

    # Docker's embedded DNS: the ACME module and the variable upstreams need it.
    resolver 127.0.0.11 valid=30s ipv6=off;

    # Section 19.6: never the webhook's `secret_path`, and the `Referer`
    # without its query (a page opened from `/auth/tg?token=` sends it).
    map $uri $rr_log_uri { ~^/tg/webhook/ /tg/webhook/***; default $uri; }
    map $http_referer $rr_log_referer { ~^(?<rr_referer_path>[^?]*) $rr_referer_path; default ''; }
    log_format rr_json escape=json
      '{"time":"$time_iso8601","remote_addr":"$remote_addr","request_id":"$request_id",'
      '"method":"$request_method","uri":"$rr_log_uri","status":$status,"bytes_sent":$bytes_sent,'
      '"request_time":$request_time,"upstream":"$upstream_addr","upstream_time":"$upstream_response_time",'
      '"host":"$host","user_agent":"$http_user_agent","referer":"$rr_log_referer","tls_protocol":"$ssl_protocol"}';
    access_log /dev/stdout rr_json;

    # nginx is the first public hop; only the compose network may set X-Forwarded-For.
    set_real_ip_from {{DOCKER_CIDR}};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    gzip on; gzip_vary on; gzip_comp_level 5; gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml font/woff2;
    # No brotli: the stock image has no module for it, and Caddy covers it (ADR-014).

    proxy_cache_path /var/cache/nginx/proxy levels=1:2 keys_zone=rr_static:10m max_size=512m inactive=7d use_temp_path=off;

    include ratelimits.inc;

    map $http_upgrade $connection_upgrade { default upgrade; '' close; }

    upstream rr_web { server web:3001; keepalive 32; }
    upstream rr_api { server api:3000; keepalive 32; }

    include tls-{{TLS_MODE}}.inc;
    include site.conf;

    # Section 20.2: nginx's own counters, on loopback inside the container.
    # Nothing outside the container can reach the port, and the format is for
    # an exporter the owner may add; the shipped dashboard reads the
    # application metrics instead.
    server {
        listen 127.0.0.1:8081;
        access_log off;
        location = /nginx_status { stub_status; }
        location / { return 404; }
    }
}
