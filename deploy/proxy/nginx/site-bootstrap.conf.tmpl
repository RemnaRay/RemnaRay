# Rendered while `certbot` mode has no certificate yet (section 21.3): HTTP
# only, so nginx starts, `./rr tls:issue` can answer the HTTP-01 challenge and
# the shop is reachable. The full `site.conf` is rendered after the issue.
server {
    listen 80 default_server;
    server_name {{DOMAIN}}{{EXTRA_DOMAINS_SUFFIX}};

    location = /healthz { access_log off; return 200 "ok\n"; add_header Content-Type text/plain; }

    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; default_type text/plain; }

    include security-headers.inc;
    include common-proxy.inc;

    location ^~ /api/ { limit_req zone=rr_api burst=30 nodelay; proxy_pass http://rr_api; }
    location ^~ /setup { limit_req zone=rr_auth burst=30 nodelay; proxy_pass http://rr_web; }
    location / { limit_req zone=rr_general burst=50 nodelay; proxy_pass http://rr_web; }

    include custom.d/*.conf;
}
