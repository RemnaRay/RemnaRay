#!/usr/bin/env sh
set -eu

command=${1:-help}
compose_file=${COMPOSE_FILE:-compose.yaml}
script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
recovery_script=$script_dir/admin-recovery.mjs

# NFR-013: one start command per profile. The profile comes from `.env`, so the
# owner never types it and never edits a proxy configuration by hand. A value
# the environment already has wins, as it does for compose itself (R59):
# `RR_VERSION=1.2.2 ./scripts/rr up` starts 1.2.2 whatever `.env` says.
if [ -f .env ]; then
  from_env_file=' '
  while IFS='=' read -r key value || [ -n "$key" ]; do
    case "$key" in
      RR_PROXY_PROFILE|RR_TLS_MODE|RR_VERSION|RR_REGISTRY|RR_*_IMAGE|RR_DOMAIN|RR_ACME_EMAIL|RR_EXTERNAL_HTTP_PORT)
        case "$from_env_file" in
          *" $key "*) ;;
          *) if printenv "$key" >/dev/null 2>&1; then continue; fi ;;
        esac
        value=${value#\"}; value=${value%\"}
        value=${value#\'}; value=${value%\'}
        export "$key=$value"
        from_env_file="$from_env_file$key "
        ;;
    esac
  done < .env
fi
profile=${RR_PROXY_PROFILE:-nginx}
tls_mode=${RR_TLS_MODE:-acme}

set -- "$@"
profiles="--profile $profile"
if [ "$tls_mode" = "certbot" ]; then
  profiles="$profiles --profile certbot"
fi
ready_timeout=300
pull_images=0
previous=''
for argument in "$@"; do
  if [ "$previous" = --wait-timeout ]; then ready_timeout=$argument; fi
  if [ "$argument" = --pull ]; then pull_images=1; fi
  previous=$argument
done
if [ "$previous" = --wait-timeout ]; then ready_timeout=''; fi
case "$ready_timeout" in ''|*[!0-9]*|0) echo 'wait-timeout must be positive seconds' >&2; exit 2 ;; esac
# A release tag (1, 1.2, 1.2.3, 1.2.3-rc.N) is upgraded on purpose
# (docs/upgrade.md), and `build` tags a source checkout's images with it, so
# `up` never pulls it on its own. Any other tag, such as the `dev` of the
# images workflow, is rebuilt under the same name: `up` pulls it first, or an
# older copy left on the server would start instead.
if ! printf '%s' "${RR_VERSION:-1}" | grep -Eqx '[0-9]+(\.[0-9]+){0,2}(-rc\.[0-9]+)?'; then
  pull_images=1
fi
case "$profile/$tls_mode" in nginx/acme|nginx/certbot|nginx/custom|caddy/acme|caddy/custom|external/none) ;;
  *) if [ "$command" != down ]; then echo 'Invalid RR_PROXY_PROFILE/RR_TLS_MODE combination' >&2; exit 2; fi ;;
esac

usage() {
  cat <<'USAGE'
Usage: ./scripts/rr {build|up|down|logs|ps|config|proxy:render|proxy:reload|tls:issue|backup|restore|theme:validate|admin:list|admin:reset-password|admin:reset-totp}

The proxy profile comes from RR_PROXY_PROFILE in .env (default: nginx), and
RR_TLS_MODE=certbot adds the certbot profile.
up and tls:issue accept --wait-timeout SECONDS (default 300 per readiness phase).
up pulls the images first when RR_VERSION is not a release tag (such as dev),
or when given --pull.
down preserves volumes; down -v explicitly removes this project's volumes.

`build` is only for running from a source checkout: a released deployment
pulls the published images instead. With no arguments it builds what the
active profile starts; otherwise name the images (app, web, nginx, caddy,
backup).

Set COMPOSE_FILE=compose.dev.yaml for the local PostgreSQL/Valkey dependencies.

Admin recovery commands use the running API container and preserve the existing
TOTP unless `admin:reset-totp` is explicitly requested. Password input is read
without echo and is never passed as a command argument or written to the audit log.
USAGE
}

# The tag `compose.yaml` resolves to for one image, so a local build lands on
# exactly the name the deployment will look for.
image_ref() {
  case "$1" in
    app) printf '%s' "${RR_APP_IMAGE:-${RR_REGISTRY:-ghcr.io/remnaray}/app:${RR_VERSION:-1}}" ;;
    web) printf '%s' "${RR_WEB_IMAGE:-${RR_REGISTRY:-ghcr.io/remnaray}/web:${RR_VERSION:-1}}" ;;
    nginx) printf '%s' "${RR_NGINX_IMAGE:-${RR_REGISTRY:-ghcr.io/remnaray}/nginx:${RR_VERSION:-1}}" ;;
    caddy) printf '%s' "${RR_CADDY_IMAGE:-${RR_REGISTRY:-ghcr.io/remnaray}/caddy:${RR_VERSION:-1}}" ;;
    backup) printf '%s' "${RR_BACKUP_IMAGE:-${RR_REGISTRY:-ghcr.io/remnaray}/backup:${RR_VERSION:-1}}" ;;
  esac
}

image_file() {
  case "$1" in
    app) printf '%s' deploy/docker/app.Dockerfile ;;
    web) printf '%s' deploy/docker/web.Dockerfile ;;
    nginx) printf '%s' deploy/proxy/nginx/Dockerfile ;;
    caddy) printf '%s' deploy/proxy/caddy/Dockerfile ;;
    backup) printf '%s' deploy/backup/Dockerfile ;;
  esac
}

compose() {
  # shellcheck disable=SC2086
  docker compose -f "$compose_file" $profiles "$@"
}
compose_all() { docker compose -f "$compose_file" --profile '*' "$@"; }

cleanup_stale_proxy() {
  case "$profile" in
    nginx) stale="proxy-caddy edge" ;;
    caddy) stale="proxy-nginx edge certbot" ;;
    external) stale="proxy-nginx proxy-caddy proxy-config proxy-reloader certbot" ;;
  esac
  if [ "$tls_mode" != certbot ]; then stale="$stale certbot"; fi
  services=$(compose_all config --services)
  for service in $stale; do
    if printf '%s\n' "$services" | grep -qx "$service"; then
      # Compose resolves the project itself, including COMPOSE_PROJECT_NAME
      # from .env. Never target global container names or remove volumes.
      compose_all rm --stop --force "$service"
    fi
  done
}

diagnose_startup() {
  echo "RemnaRay readiness failed (timeout ${ready_timeout}s)." >&2
  compose_all ps --all >&2 || true
  compose logs --tail=80 >&2 || true
}

wait_for_ready() {
  echo "Waiting up to ${ready_timeout}s for service health: postgres, valkey, api, bot, worker, web and selected proxy; migrate must exit 0."
  if ! compose up -d --wait --wait-timeout "$ready_timeout"; then
    diagnose_startup
    return 1
  fi
}

wait_for_https() {
  domain=${RR_DOMAIN:?RR_DOMAIN is required}
  command -v curl >/dev/null || { echo 'Install curl to check HTTPS readiness' >&2; return 1; }
  deadline=$(($(date +%s) + ready_timeout))
  result="No HTTPS response before deadline"
  echo "Waiting up to ${ready_timeout}s for https://${domain}/healthz..."
  # Reach this deployment directly, preserving Host/SNI; do not accidentally
  # accept another server at an old DNS address. ACME requires a trusted chain.
  set -- --noproxy '*' --resolve "$domain:443:127.0.0.1"
  if [ "$tls_mode" = custom ]; then set -- "$@" --cacert deploy/proxy/certs/fullchain.pem; fi
  while [ "$(date +%s)" -lt "$deadline" ]; do
    remaining=$((deadline - $(date +%s)))
    if [ "$remaining" -le 0 ]; then break; fi
    if [ "$remaining" -gt 5 ]; then remaining=5; fi
    if result=$(curl "$@" -fsS --max-time "$remaining" "https://${domain}/healthz" 2>&1) && [ "$result" = ok ]; then
      echo "HTTPS is ready at https://${domain}/healthz."
      return 0
    fi
    sleep 1
  done
  echo "HTTPS did not become ready: $result" >&2
  diagnose_startup
  return 1
}

render_proxy() {
  compose exec -T proxy-config node dist/tools/render-proxy.js --profile "$profile" --tls "$tls_mode"
  compose exec -T proxy-reloader node dist/tools/proxy-reloader.js --profile "$profile" --reload
}

read_secret() {
  prompt=$1
  printf '%s' "$prompt" >&2
  stty -echo
  IFS= read -r secret
  stty echo
  printf '\n' >&2
  printf '%s' "$secret"
}

admin_recovery() {
  action=$1
  email_value=''
  password_value=''
  password_confirm=''
  printf 'Admin email: ' >&2
  IFS= read -r email_value
  if [ -z "$email_value" ]; then echo 'Admin email is required' >&2; return 2; fi
  if [ "$action" = reset-password ]; then
    password_value=$(read_secret 'New password: ')
    password_confirm=$(read_secret 'Repeat password: ')
    if [ "$password_value" != "$password_confirm" ]; then
      echo 'Passwords do not match' >&2
      return 2
    fi
  fi
  RR_RECOVERY_ACTION=$action RR_RECOVERY_EMAIL=$email_value RR_RECOVERY_PASSWORD=$password_value \
    compose exec -T \
      -e RR_RECOVERY_ACTION \
      -e RR_RECOVERY_EMAIL \
      -e RR_RECOVERY_PASSWORD \
      api node --input-type=module - < "$recovery_script"
}

sync_certbot() {
  compose run --rm --no-deps --entrypoint sh certbot /scripts/certbot.sh sync
}

start_deployment() {
  if [ "$pull_images" = 1 ]; then
    echo "Pulling the ${RR_VERSION:-1} images."
    compose pull
  fi
  cleanup_stale_proxy
  if [ "$tls_mode" = certbot ]; then sync_certbot; fi
  if [ "$profile" != external ]; then
    renderer_before=$(compose ps -aq proxy-config)
    proxy_before=$(compose ps -aq "proxy-$profile")
  fi
  wait_for_ready
  if [ "$tls_mode" = certbot ]; then
    sync_certbot
    render_proxy
    if ! compose exec -T proxy-nginx test -f "/etc/letsencrypt/live/$RR_DOMAIN/fullchain.pem"; then
      echo 'HTTP bootstrap ready; run ./scripts/rr tls:issue for the initial certificate.'
      return
    fi
  elif [ "$profile" != external ]; then
    # A changed RR_TLS_MODE recreates `proxy-config`, whose first render asks
    # for no reload, but not the proxy, whose definition does not name it: the
    # running proxy would keep serving the previous mode's configuration.
    if [ -n "$proxy_before" ] && [ "$(compose ps -aq "proxy-$profile")" = "$proxy_before" ] \
      && [ "$(compose ps -aq proxy-config)" != "$renderer_before" ]; then
      render_proxy
    fi
  fi
  if [ "$profile" != external ]; then wait_for_https; fi
  echo 'RemnaRay services are ready.'
}

case "$command" in
  build)
    # Section 24.4 publishes the images to GHCR, and `compose.yaml` names them
    # rather than carrying build contexts. A source checkout that is ahead of
    # the last release — or a fork that has published nothing — has no images
    # to pull, so this builds them under the names compose resolves to. Only
    # the proxy of the active profile is built: the other one is never started.
    shift
    if [ $# -gt 0 ]; then
      images="$*"
    else
      images="app web backup"
      # `external` terminates TLS somewhere else and starts no proxy of ours.
      if [ "$profile" != external ]; then
        images="$images $profile"
      fi
    fi
    for image in $images; do
      file=$(image_file "$image")
      if [ -z "$file" ]; then
        echo "unknown image: $image (app, web, nginx, caddy, backup)" >&2
        exit 2
      fi
      ref=$(image_ref "$image")
      echo "==> $ref"
      docker build -f "$file" -t "$ref" .
    done
    ;;
  up)
    start_deployment
    ;;
  down)
    # Enable every RemnaRay deployment profile so a profile changed in .env
    # cannot hide a proxy container created by the previous profile. Volumes
    # are deliberately preserved; `down -v` remains the destructive command.
    # shellcheck disable=SC2086
    shift
    compose_all down "$@"
    ;;
  logs)
    shift
    # shellcheck disable=SC2086
    docker compose -f "$compose_file" $profiles logs "$@"
    ;;
  ps)
    # shellcheck disable=SC2086
    docker compose -f "$compose_file" $profiles ps
    ;;
  config)
    # shellcheck disable=SC2086
    docker compose -f "$compose_file" $profiles config
    ;;
  proxy:render)
    # Re-render the proxy configuration without waiting for a settings change.
    render_proxy
    ;;
  tls:issue)
    # Section 21.3: the first certificate of the `certbot` mode. nginx is
    # already serving the HTTP-only bootstrap configuration, which answers the
    # HTTP-01 challenge from the shared webroot.
    if [ "$tls_mode" != "certbot" ]; then
      echo "tls:issue applies to RR_TLS_MODE=certbot; this deployment uses $tls_mode" >&2
      exit 1
    fi
    email=${RR_ACME_EMAIL:-}
    if [ -z "${RR_DOMAIN:-}" ] || [ -z "$email" ]; then
      echo "tls:issue requires RR_DOMAIN and RR_ACME_EMAIL in .env" >&2
      exit 2
    fi
    wait_for_ready
    # R118: one certificate for every name the site answers on — the redirect
    # server of `extra_domains` presents it too. The renderer lists them, the
    # configured domain first, from the settings (R57: a domain changed in the
    # console); before its first render, `.env` names the domain.
    domains=$(compose exec -T proxy-config cat /proxy-conf/certbot-domains 2>/dev/null || true)
    if [ -z "$domains" ]; then domains=$RR_DOMAIN; fi
    domain=''
    set --
    for name in $domains; do
      if ! printf '%s' "$name" | grep -Eqx '[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?'; then
        echo "Not a domain name: $name" >&2
        exit 2
      fi
      if [ -z "$domain" ]; then domain=$name; fi
      set -- "$@" -d "$name"
    done
    echo "Issuing with certbot certonly for $* (keeping an existing valid certificate)."
    compose stop certbot
    trap 'compose start certbot' EXIT
    compose run --rm --no-deps --entrypoint certbot certbot \
      certonly --webroot -w /var/www/certbot "$@" -m "$email" --agree-tos -n \
      --cert-name "$domain" --keep-until-expiring \
      --deploy-hook 'sh /scripts/certbot.sh deploy'
    # Also sync for keep-until-expiring: Certbot does not run the deploy hook
    # when it keeps a valid certificate. Render completion precedes reload.
    sync_certbot
    render_proxy
    compose start certbot
    trap - EXIT
    wait_for_https
    ;;
  proxy:reload)
    # Ask `proxy-reloader` to validate and apply what is currently rendered.
    docker compose -f "$compose_file" exec -T valkey \
      valkey-cli publish rr:proxy.reload '{"reason":"manual"}'
    ;;
  backup)
    # Section 20.5: the same step the schedule runs, on demand. The image's
    # entrypoint is the script itself, so the subcommand is the whole argument
    # — naming the script again makes it the subcommand, and it refuses.
    docker compose -f "$compose_file" run --rm backup once
    ;;
  restore)
    shift
    if [ $# -lt 1 ]; then
      echo "Usage: ./scripts/rr restore backups/<file>.dump" >&2
      exit 2
    fi
    # The restore of section 20.5 drives compose itself — it stops the stack,
    # brings PostgreSQL up alone, restores and starts everything again — so it
    # runs on the host. Inside the `backup` container there is no compose and
    # no socket to reach it with.
    COMPOSE_FILE="$compose_file" RR_PROXY_PROFILE="$profile" \
      deploy/backup/restore.sh "$1"
    ;;
  theme:validate)
    shift
    pnpm theme-validate "${1:-themes/manta}"
    ;;
  admin:list)
    RR_RECOVERY_ACTION=list compose exec -T -e RR_RECOVERY_ACTION api node --input-type=module - < "$recovery_script"
    ;;
  admin:reset-password | admin:reset-totp)
    admin_recovery "${command#admin:}"
    ;;
  help | --help | -h)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
