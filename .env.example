RR_DOMAIN=shop.example.com
RR_ACME_EMAIL=owner@example.com
RR_PROXY_PROFILE=nginx
RR_TLS_MODE=acme
RR_APP_KEY=replace-with-openssl-rand-base64-32
RR_SETUP_TOKEN=replace-with-one-time-setup-token
RR_INTERNAL_TOKEN=replace-with-internal-api-token
RR_THEME_UPLOAD=false
# Single-quoted, so compose takes it literally: any character but a single
# quote. The application builds its connection URL from it, encoded.
POSTGRES_PASSWORD='replace-with-database-password'
POSTGRES_USER=remnaray
POSTGRES_DB=remnaray
VALKEY_URL=redis://valkey:6379/0
# Section 21.7: the only addresses whose `X-Forwarded-*` headers are believed.
# The compose network is right for every profile: behind RR_PROXY_PROFILE=external
# the API's peer is still the `edge` container. Add what sits in front of
# `edge` after it (your proxy's subnet, a CDN's ranges), comma-separated.
RR_TRUSTED_PROXIES=172.28.0.0/16
# Only with RR_PROXY_PROFILE=external: the port `edge` publishes on loopback.
RR_EXTERNAL_HTTP_PORT=8080
# Where the images come from, and which tag. The defaults are the published
# release; a fork that builds its own images in CI points at its own namespace
# (`ghcr.io/<owner>`) and the tag it published. A single image can be replaced
# outright with RR_APP_IMAGE, RR_WEB_IMAGE, RR_NGINX_IMAGE, RR_CADDY_IMAGE or
# RR_BACKUP_IMAGE.
RR_REGISTRY=ghcr.io/remnaray
RR_VERSION=1
RR_LOG_LEVEL=info
# Section 24.6: the repository whose GitHub Releases the daily update check
# reads; set it only for a fork.
# RR_UPDATE_REPOSITORY=RemnaRay/RemnaRay
# Development and test stands only (section 22.4): registers the `mock` payment
# provider, whose webhook secret is public. Never true on a live shop.
RR_PAYMENTS_MOCK=false
# Only with --profile monitoring (section 20.2). Grafana is not published; it
# is reached over the compose network, an SSH tunnel or the owner's own proxy.
# Grafana refuses to start without it, or with "admin"; init-env.sh makes one.
RR_GRAFANA_PASSWORD=replace-with-grafana-password
