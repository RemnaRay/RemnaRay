{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Keep major updates behind an explicit maintainer decision",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "21 days",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Automerge safe patch updates after the full CI gate",
      "matchUpdateTypes": ["patch"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["!prisma", "!@prisma/*", "!bullmq", "!ioredis", "!@nestjs/*"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group NestJS packages",
      "matchPackageNames": ["@nestjs/*"],
      "groupName": "nestjs"
    },
    {
      "description": "Group Prisma packages",
      "matchPackageNames": ["prisma", "@prisma/*"],
      "groupName": "prisma"
    },
    {
      "description": "Group grammY packages",
      "matchPackageNames": ["grammy", "@grammyjs/*"],
      "groupName": "grammy"
    },
    {
      "description": "Group Next and React packages",
      "matchPackageNames": ["next", "next-intl", "react", "react-dom"],
      "groupName": "next"
    },
    {
      "description": "Group Tailwind packages",
      "matchPackageNames": ["tailwindcss", "tailwind-merge"],
      "groupName": "tailwind"
    },
    {
      "description": "Group ESLint packages",
      "matchPackageNames": ["eslint", "@eslint/*", "typescript-eslint"],
      "groupName": "eslint"
    },
    {
      "description": "Group container image updates",
      "matchDatasources": ["docker"],
      "groupName": "docker-images"
    },
    {
      "description": "Group GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Section 24.6 exceptions: pnpm 12 waits for a separate decision",
      "matchPackageNames": ["pnpm"],
      "allowedVersions": "<12"
    },
    {
      "description": "Section 24.6 exceptions: Prisma 8 waits for a separate decision",
      "matchPackageNames": ["prisma", "@prisma/*"],
      "allowedVersions": "<8"
    },
    {
      "description": "Section 24.6 exceptions: grammY 2 waits for a separate decision",
      "matchPackageNames": ["grammy"],
      "allowedVersions": "<2"
    },
    {
      "description": "Section 24.6 exceptions: ioredis 6 waits for a separate decision (ADR-006)",
      "matchPackageNames": ["ioredis"],
      "allowedVersions": "<6"
    },
    {
      "description": "Section 24.6 exceptions: nginx stays on the stable 1.30 branch, never mainline 1.31",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nginx"],
      "allowedVersions": "<1.31"
    },
    {
      "description": "Section 24.6: postgres and valkey are updated through digest pull requests",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres", "valkey/valkey"],
      "pinDigests": true
    },
    {
      "description": "Never automerge money movement and provider clients",
      "matchPackageNames": ["prisma", "@prisma/*", "bullmq", "ioredis", "@nestjs/*", "undici"],
      "automerge": false
    }
  ]
}
